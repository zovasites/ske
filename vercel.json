{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/api/quote",
      "dest": "/api/quote.js"
    },
    {
      "src": "/api/enquiry",
      "dest": "/api/enquiry.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
